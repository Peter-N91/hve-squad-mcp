{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.28/MicrosoftTeams.schema.json",
  "manifestVersion": "1.28",
  "version": "1.0.0",
  "id": "3f6b0c74-9d2a-5e18-b7c3-1a4e8d905f62",
  "developer": {
    "name": "hve-squad",
    "websiteUrl": "https://peter-n91.github.io/hve-squad-mcp/",
    "privacyUrl": "https://peter-n91.github.io/hve-squad-mcp/#privacy",
    "termsOfUseUrl": "https://peter-n91.github.io/hve-squad-mcp/#terms"
  },
  "name": {
    "short": "HVE Squad",
    "full": "HVE Squad for Copilot Cowork"
  },
  "description": {
    "short": "Governed squad research, planning, review, business case, and backlog",
    "full": "Routes work to the HVE Squad, a governed advisory squad that runs server-side under its own gates and returns finished artifacts (squad-guided / embedded). Includes stages for research, architecture, delivery planning, artifact review, business case, backlog decomposition with Azure DevOps and Jira handoff, governed end-to-end runs with a multi-domain council, federation across sub-squads, squad memory and run history, and deterministic deck rendering."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0B5394",
  "agentSkills": [
    { "folder": "./skills/hve-squad-orchestrator" },
    { "folder": "./skills/squad-researcher" },
    { "folder": "./skills/system-architecture-reviewer" },
    { "folder": "./skills/squad-lead" },
    { "folder": "./skills/squad-reviewer" },
    { "folder": "./skills/brd-builder" },
    { "folder": "./skills/functional-planner" },
    { "folder": "./skills/squad-coordinator" },
    { "folder": "./skills/squad-federation-coordinator" },
    { "folder": "./skills/memory-curator" },
    { "folder": "./skills/deck-renderer" }
  ],
  "agentConnectors": [
    {
      "id": "hve-squad-mcp",
      "displayName": "HVE Squad",
      "description": "Governed squad stages served by the hve-squad MCP server (squad-guided / embedded).",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "https://<CONTAINER_APP_FQDN>/mcp",
          "mcpToolDescription": {
            "file": "./tools/hve-squad-tools.json"
          },
          "authorization": {
            "type": "OAuthPluginVault",
            "referenceId": "<OAUTH_CLIENT_REGISTRATION_ID>"
          }
        }
      }
    }
  ]
}
