{
  "name": "@hve-squad/mcp",
  "version": "0.7.1",
  "type": "module",
  "description": "Outbound Model Context Protocol (MCP) server that exposes the hve-squad as coarse intent tools (squad_research, squad_plan, squad_review, squad_architect, squad_run) plus squad_federate for the opt-in federation of named sub-squads, to MCP hosts such as VS Code GitHub Copilot. Phase 0: local stdio, delegated execution.",
  "license": "MIT",
  "homepage": "https://peter-n91.github.io/hve-squad-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peter-N91/hve-squad-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Peter-N91/hve-squad-mcp/issues"
  },
  "bin": {
    "hve-squad-mcp": "dist/src/server.js"
  },
  "files": [
    "dist/src",
    "tools.catalog.yml",
    "generated/mcp-tools.schema.json",
    "generated/copilot-studio-connector",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit --pretty false",
    "generate": "tsx generators/build-manifests.ts",
    "generate:check": "tsx generators/build-manifests.ts --check",
    "generate:connector": "tsx generators/build-copilot-studio-connector.ts",
    "generate:connector:check": "tsx generators/build-copilot-studio-connector.ts --check",
    "snapshot:cast": "tsx host/snapshot-cast.ts",
    "snapshot:cast:check": "tsx host/snapshot-cast.ts --check",
    "snapshot:render": "tsx host/snapshot-render.ts",
    "version:set": "tsx scripts/set-version.ts",
    "change": "tsx scripts/new-change-fragment.ts",
    "release:prep": "tsx scripts/release-prep.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:conformance": "node --import tsx --test \"test/conformance/**/*.test.ts\"",
    "start": "node dist/src/server.js",
    "start:http": "node dist/src/server-http.js",
    "start:worker": "node dist/src/worker-main.js"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "jose": "^6.2.9",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
