            "api://<SQUAD_RESOURCE_CLIENT_ID>/Squad.Render",
            "api://<SQUAD_RESOURCE_CLIENT_ID>/Squad.Memory",
            "api://<SQUAD_RESOURCE_CLIENT_ID>/Squad.MemoryWrite",
            "api://<SQUAD_RESOURCE_CLIENT_ID>/Squad.Business",
