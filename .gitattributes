# The cast bundle carries an integrity record (host/cast/manifest.json) of per-file
# SHA-256 hashes. With core.autocrlf those hashes would differ between a Windows
# working tree and a Linux runner for identical content, so the bundle is pinned to
# LF everywhere. host/snapshot-cast.ts also normalizes before hashing, which keeps
# the check correct for a checkout that ignores this file.
host/cast/** text eol=lf
