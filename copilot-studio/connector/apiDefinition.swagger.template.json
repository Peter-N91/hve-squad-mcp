{
  "swagger": "2.0",
  "info": {
    "title": "hve-squad (squad-guided / embedded)",
    "description": "Calls the hve-squad MCP server (squad-guided / embedded). The squad runs server-side under its gates and methodology. This template requests every scope the server can serve: the four advisory tools of a default deployment (squad_research, squad_plan, squad_review, squad_architect) plus the opt-in gated pipeline, federation, business, memory, and render surfaces. Remove any scope your app registration does not expose — asking for one it does not expose fails consent.",
    "version": "1.0"
  },
  "host": "<CONTAINER_APP_FQDN>",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/mcp": {
      "post": {
        "summary": "hve-squad MCP (squad-guided / embedded)",
        "description": "Streamable HTTP MCP endpoint. squad-guided / embedded.",
        "operationId": "InvokeMCP",
        "x-ms-agentic-protocol": "mcp-streamable-1.0",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "entra-oauth2": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/<ENTRA_TENANT_ID>/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/<ENTRA_TENANT_ID>/oauth2/v2.0/token",
      "scopes": {
        "api://<ENTRA_CLIENT_ID>/Squad.Research": "Invoke squad_research",
        "api://<ENTRA_CLIENT_ID>/Squad.Plan": "Invoke squad_plan",
        "api://<ENTRA_CLIENT_ID>/Squad.Review": "Invoke squad_review",
        "api://<ENTRA_CLIENT_ID>/Squad.Architect": "Invoke squad_architect",
        "api://<ENTRA_CLIENT_ID>/Squad.Run": "Invoke squad_run and squad_status",
        "api://<ENTRA_CLIENT_ID>/Squad.Federate": "Invoke squad_federate",
        "api://<ENTRA_CLIENT_ID>/Squad.Business": "Invoke squad_business_plan",
        "api://<ENTRA_CLIENT_ID>/Squad.Backlog": "Invoke squad_backlog",
        "api://<ENTRA_CLIENT_ID>/Squad.Memory": "Invoke squad_memory_read and squad_history",
        "api://<ENTRA_CLIENT_ID>/Squad.MemoryWrite": "Invoke squad_memory_write and squad_memory_sync",
        "api://<ENTRA_CLIENT_ID>/Squad.Render": "Invoke squad_render_pptx"
      }
    }
  },
  "security": [
    {
      "entra-oauth2": []
    }
  ]
}
