# Build output and dependencies for the production squad-mcp server.
# The generated/ runtime descriptor is intentionally NOT ignored: it is a
# committed, regenerable build artifact (see generators/build-manifests.ts).
node_modules/
dist/
*.tsbuildinfo

# Disposable Step 0.1 spike — kept locally as a design record but never shipped.
# Its purpose (answer Questions A/B, recorded in FINDINGS.md) is complete; it is
# not part of the production server and the build already excludes it (tsconfig).
spike/

# Compiled Bicep ARM output (regenerated by 'az bicep build')
host/infra/main.json

.copilot-tracking/

# ---------------------------------------------------------------------------
# Deployment-specific and secret material. THIS REPOSITORY IS PUBLIC — never
# commit anything below.
# ---------------------------------------------------------------------------

# The filled-in Copilot Studio connector carries the live endpoint host, the
# Entra tenant id, and the app registration client id. Only the *.template.json
# placeholder versions are tracked.
copilot-studio/connector/apiDefinition.swagger.json
copilot-studio/connector/apiProperties.json

# Bicep parameter files completed with real tenant/subscription values.
host/infra/*.local.bicepparam

# Environment files and credential material.
.env
.env.*
*.pem
*.pfx
*.p12
